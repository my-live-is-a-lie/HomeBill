rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUtilityType(t) {
      return t is string && t.size() <= 20 &&
             t in [
               'gas', 'electricity', 'water', 'internet', 'telecom',
               'shopping', 'dining', 'maintenance', 'fuel', 'other'
             ];
    }

    function isValidSheetItems(items) {
      return items is list &&
             items.size() <= 25 &&
             (items.size() == 0 || (
               items[0] is map &&
               items[0].keys().hasAll(['label', 'value', 'unit']) &&
               items[0].keys().hasOnly(['label', 'value', 'unit']) &&
               items[0].label is string && items[0].label.size() >= 1 && items[0].label.size() <= 120 &&
               items[0].value is string && items[0].value.size() <= 200 &&
               items[0].unit is string && items[0].unit.size() <= 30
             ));
    }

    function isValidTemplateMode(m) {
      return m is string && m in ['legacy', 'preset', 'custom'];
    }

    function isValidRememberedRow(row) {
      return row is map &&
             row.keys().hasAll(['label', 'value', 'unit']) &&
             row.keys().hasOnly(['label', 'value', 'unit']) &&
             row.label is string && row.label.size() >= 1 && row.label.size() <= 120 &&
             row.value is string && row.value.size() <= 200 &&
             row.unit is string && row.unit.size() <= 30;
    }

    // Rules cannot loop over a list, so the first and last entries are checked; the app
    // sanitizes every entry before writing.
    function isValidRememberedRows(rows) {
      return rows is list &&
             rows.size() <= 40 &&
             (rows.size() == 0 || (
               isValidRememberedRow(rows[0]) &&
               isValidRememberedRow(rows[rows.size() - 1])
             ));
    }

    // --- Validation Blueprints ---
    function isValidCategory(data) {
      return isSignedIn() &&
             data is map &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             isValidUtilityType(data.utilityType) &&
             data.defaultUnit is string && data.defaultUnit.size() >= 1 && data.defaultUnit.size() <= 20 &&
             data.alertThresholdPercent is number &&
             data.alertThresholdPercent >= 5 && data.alertThresholdPercent <= 200 &&
             // Duration tracking flag, added with the bill-duration feature. Optional so
             // documents written by older app versions without this field still validate.
             (!('trackDuration' in data) || data.trackDuration is bool) &&
             // Bill-form template mode and remembered rows. Optional so documents written by
             // older app versions without these fields still validate.
             (!('templateMode' in data) || isValidTemplateMode(data.templateMode)) &&
             (!('rememberedRows' in data) || isValidRememberedRows(data.rememberedRows)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBill(data) {
      return isSignedIn() &&
             data is map &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             isValidId(data.categoryId) &&
             data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 80 &&
             isValidUtilityType(data.utilityType) &&
             data.billDateIso is string && data.billDateIso.size() == 10 &&
             data.billDateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.billingMonth is string && data.billingMonth.size() == 7 &&
             data.billingMonth.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.billDateEpochMillis is int && data.billDateEpochMillis > 0 &&
             // Consumption tracking timestamps, added with the bill-duration feature.
             // Each is either absent (older app versions), null (step not happened yet),
             // or a positive epoch-millis timestamp.
             (!('startedAtEpochMillis' in data) || data.startedAtEpochMillis == null ||
              (data.startedAtEpochMillis is int && data.startedAtEpochMillis > 0)) &&
             (!('endedAtEpochMillis' in data) || data.endedAtEpochMillis == null ||
              (data.endedAtEpochMillis is int && data.endedAtEpochMillis > 0)) &&
             data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 10000000 &&
             data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 16 &&
             data.consumptionValue is number && data.consumptionValue >= 0 && data.consumptionValue <= 10000000 &&
             data.consumptionUnit is string && data.consumptionUnit.size() >= 1 && data.consumptionUnit.size() <= 20 &&
             data.previousReading is number && data.previousReading >= 0 && data.previousReading <= 100000000 &&
             data.currentReading is number && data.currentReading >= 0 && data.currentReading <= 100000000 &&
             data.invoiceNumber is string && data.invoiceNumber.size() <= 80 &&
             data.providerName is string && data.providerName.size() <= 120 &&
             data.rawExtractedText is string && data.rawExtractedText.size() <= 5000 &&
             data.notes is string && data.notes.size() <= 1000 &&
             data.sourceType is string && data.sourceType.size() <= 20 &&
             data.sourceType in ['manual', 'camera_ai'] &&
             isValidSheetItems(data.sheetItems) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBudget(data) {
      return isSignedIn() &&
             data is map &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.monthlyLimit is number && data.monthlyLimit >= 0 && data.monthlyLimit <= 10000000 &&
             data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 16 &&
             data.warningPercent is number && data.warningPercent >= 10 && data.warningPercent <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isCategoryOwnedByCaller(catId) {
      return exists(/databases/$(database)/documents/categories/$(catId)) &&
             get(/databases/$(database)/documents/categories/$(catId)).data.userId == request.auth.uid;
    }

    // --- Collection: Household Bill Categories ---
    match /categories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(categoryId) &&
                       incoming().keys().hasAll([
                         'userId', 'name', 'utilityType', 'defaultUnit',
                         'alertThresholdPercent', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'name', 'utilityType', 'defaultUnit',
                         'alertThresholdPercent', 'createdAt', 'updatedAt',
                         'trackDuration', 'templateMode', 'rememberedRows'
                       ]) &&
                       isValidCategory(incoming());

      allow update: if isValidCategory(incoming()) &&
                       isValidId(categoryId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action: Edit Category Metadata or Alert Threshold
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'utilityType', 'defaultUnit', 'alertThresholdPercent', 'updatedAt',
                           'trackDuration', 'templateMode', 'rememberedRows'
                         ])
                       );

      allow delete: if isSignedIn() && isValidId(categoryId) && existing().userId == request.auth.uid;
    }

    // --- Collection: Monthly Bill Records & Extracted Sheets ---
    match /bills/{billId} {
      allow get: if isSignedIn() && isValidId(billId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(billId) &&
                       incoming().keys().hasAll([
                         'userId', 'categoryId', 'categoryName', 'utilityType',
                         'billDateIso', 'billingMonth', 'billDateEpochMillis',
                         'totalAmount', 'currency', 'consumptionValue', 'consumptionUnit',
                         'previousReading', 'currentReading', 'invoiceNumber', 'providerName',
                         'rawExtractedText', 'notes', 'sourceType', 'sheetItems',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'categoryId', 'categoryName', 'utilityType',
                         'billDateIso', 'billingMonth', 'billDateEpochMillis',
                         'totalAmount', 'currency', 'consumptionValue', 'consumptionUnit',
                         'previousReading', 'currentReading', 'invoiceNumber', 'providerName',
                         'rawExtractedText', 'notes', 'sourceType', 'sheetItems',
                         'createdAt', 'updatedAt',
                         'startedAtEpochMillis', 'endedAtEpochMillis'
                       ]) &&
                       isValidBill(incoming()) &&
                       isCategoryOwnedByCaller(incoming().categoryId);

      allow update: if isValidBill(incoming()) &&
                       isValidId(billId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().categoryId == existing().categoryId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action: Edit Bill Details, Readings, Notes, or Sheet Items
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'categoryName', 'utilityType', 'billDateIso', 'billingMonth',
                           'billDateEpochMillis', 'totalAmount', 'currency',
                           'consumptionValue', 'consumptionUnit', 'previousReading',
                           'currentReading', 'invoiceNumber', 'providerName',
                           'rawExtractedText', 'notes', 'sourceType', 'sheetItems',
                           'updatedAt', 'startedAtEpochMillis', 'endedAtEpochMillis'
                         ])
                       );

      allow delete: if isSignedIn() && isValidId(billId) && existing().userId == request.auth.uid;
    }

    // --- Collection: Household Monthly Budget Configuration ---
    match /budgets/{budgetId} {
      allow get: if isSignedIn() &&
                    budgetId is string &&
                    budgetId.size() >= 1 &&
                    budgetId.size() <= 128 &&
                    budgetId == request.auth.uid &&
                    (resource == null || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       budgetId is string &&
                       budgetId.size() >= 1 &&
                       budgetId.size() <= 128 &&
                       budgetId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'monthlyLimit', 'currency', 'warningPercent', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'monthlyLimit', 'currency', 'warningPercent', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidBudget(incoming());

      allow update: if isValidBudget(incoming()) &&
                       budgetId is string &&
                       budgetId.size() >= 1 &&
                       budgetId.size() <= 128 &&
                       budgetId == request.auth.uid &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'monthlyLimit', 'currency', 'warningPercent', 'updatedAt'
                         ])
                       );

      allow delete: if isSignedIn() &&
                       budgetId is string &&
                       budgetId.size() >= 1 &&
                       budgetId.size() <= 128 &&
                       budgetId == request.auth.uid &&
                       existing().userId == request.auth.uid;
    }
  }
}
